# Local agent environment — copy to .env and fill in. NEVER commit the real .env file.
# This file lists variable NAMES ONLY. No real values.

# Supabase (server-side sync only — service role key, never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail OAuth (from Google Cloud Console — Desktop App OAuth client)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# AI fallback categorization (optional — app works without this)
GEMINI_API_KEY=
AI_CATEGORIZATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=80

# Local agent <-> web app communication (localhost only)
LOCAL_AGENT_PORT=8765
