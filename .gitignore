# ---- Secrets & credentials ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json
oauth_token*.json
client_secret*.json

# ---- Local vault / sensitive local state ----
services/local-agent/.vault/
services/local-agent/vault/
services/local-agent/*.vault
services/local-agent/local_agent.sqlite*
