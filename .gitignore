# ---- Financial documents (never commit real statements) ----
*.pdf
!tests/fixtures/**/*.pdf
data/
!data/.gitkeep

# ---- Logs & temp ----
*.log
logs/
tmp/
temp/
services/local-agent/tmp/

# ---- Node ----
node_modules/
apps/web/node_modules/
