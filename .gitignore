apps/web/out/
.next/
out/
dist/
build/
.turbo/
.vercel/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
services/local-agent/.venv/
services/local-agent/venv/
*.egg-info/
.pytest_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

